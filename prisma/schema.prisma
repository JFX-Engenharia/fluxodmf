// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERADOR
  GESTOR
  APROVADOR
  ADMINISTRADOR
  COLABORADOR
}

/// ENVIADA e o unico valor que a API escreve hoje. CONFERIDA fica reservada
/// para a triagem futura no painel: nenhum endpoint grava esse status ainda.
enum ReceiptNoteStatus {
  ENVIADA
  CONFERIDA
}

enum UserStatus {
  PENDENTE
  ATIVO
  RECUSADO
  INATIVO
}

enum PaymentStatus {
  PENDENTE
  EM_ANALISE
  APROVADO
  REPROVADO
  TRANSFERIDO
  INFO_SOLICITADA
  CORRIGIDO
  CANCELADO
}

enum ImportStatus {
  PENDENTE
  PROCESSANDO
  CONFIRMADO
  FALHOU
}

enum ActionType {
  IMPORTAR
  APROVAR
  REPROVAR
  TRANSFERIR
  SOLICITAR_INFO
  RESPONDER_INFO
  CANCELAR
  REABRIR
  ANALISAR
}

enum DailyFlowStatus {
  RASCUNHO
  EM_APROVACAO
  FECHADO
}

enum DailyFlowEventType {
  CRIADO
  ENVIADO_APROVACAO
  FECHADO
  REABERTO
}

enum StandardReasonAction {
  REPROVAR
  TRANSFERIR
  CANCELAR
  SOLICITAR_INFO
  REABRIR
}

enum AdvanceStatus {
  ABERTO
  PRESTADO
  FECHADO
  CANCELADO
}

enum AllocationSource {
  MANUAL
  REGRA
}

enum PaymentRequestStatus {
  PENDENTE
  APROVADO
  REPROVADO
  CANCELADO
}

model User {
  id            String            @id @default(cuid())
  name          String
  username      String            @unique
  email         String            @unique
  passwordHash  String?
  role          Role              @default(OPERADOR)
  status        UserStatus        @default(PENDENTE)
  phone         String?
  reviewedById  String?
  reviewedBy    User?             @relation("UserReviewer", fields: [reviewedById], references: [id])
  reviewed      User[]            @relation("UserReviewer")
  reviewedAt    DateTime?
  works         UserWork[]
  imports       ImportBatch[]     @relation("ImportedBy")
  payments      Payment[]         @relation("PaymentCreatedBy")
  actions       PaymentAction[]
  auditLogs     AuditLog[]        @relation("AuditActor")
  flowsStarted  DailyFlow[]       @relation("DailyFlowStartedBy")
  flowsClosed   DailyFlow[]       @relation("DailyFlowClosedBy")
  flowEvents    DailyFlowEvent[]  @relation("DailyFlowEventActor")
  approvals     PaymentApproval[]
  advances      Advance[]         @relation("AdvanceCreatedBy")
  workApprovals WorkApprover[]
  paymentRequests PaymentRequest[] @relation("PaymentRequestRequestedBy")
  reviewedPaymentRequests PaymentRequest[] @relation("PaymentRequestReviewedBy")
  requestApprovals PaymentRequestApproval[] @relation("PaymentRequestApprover")
  sessions      UserSession[]
  devices       Device[]
  loginEvents   LoginEvent[]
  receiptNotes  ReceiptNote[]     @relation("ReceiptNoteAuthor")
  authProvider  String?
  externalSubject String?
  lastLoginAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@unique([authProvider, externalSubject])
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  boundDevice Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  provider   String   @default("local")
  ipAddress  String?
  userAgent  String?
  device     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt, expiresAt])
  @@index([deviceId])
}

model Device {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  name       String
  userAgent  String?
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  revokedAt  DateTime?
  sessions   UserSession[]

  @@unique([userId, tokenHash])
  @@index([userId, revokedAt])
}

model LoginEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  identifier String
  provider   String   @default("local")
  success    Boolean
  reason     String?
  ipAddress  String?
  userAgent  String?
  device     String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Work {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  costCenterAliases String         @default("[]")
  active            Boolean        @default(true)
  users             UserWork[]
  payments          Payment[]
  contributions     Contribution[]
  approvalRules     ApprovalRule[]
  allocationSplits  AllocationRuleSplit[]
  paymentAllocations PaymentAllocation[]
  advances          Advance[]
  paymentRequests    PaymentRequest[]
  approvers          WorkApprover[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model WorkApprover {
  workId String
  userId String
  work   Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workId, userId])
  @@index([userId])
}

model PaymentRequestApproval {
  id         String         @id @default(cuid())
  requestId  String
  request    PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId String
  approver   User           @relation("PaymentRequestApprover", fields: [approverId], references: [id])
  approvedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([requestId, approverId])
  @@index([approverId, approvedAt])
}

model UserWork {
  userId String
  workId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
}

model ImportBatch {
  id            String         @id @default(cuid())
  fileName      String
  totalRows     Int
  validRows     Int
  invalidRows   Int
  status        ImportStatus   @default(CONFIRMADO)
  importedById  String
  importedBy    User           @relation("ImportedBy", fields: [importedById], references: [id])
  payments      Payment[]
  contributions Contribution[]
  dailyFlow     DailyFlow?
  sourceFileName        String         @default("")
  flowName              String         @default("")
  payload               String         @default("")
  processedRows         Int            @default(0)
  importedRows          Int            @default(0)
  importedContributions Int            @default(0)
  createdAccounts       String         @default("[]")
  attempts              Int            @default(0)
  error                 String         @default("")
  startedAt             DateTime?
  finishedAt            DateTime?
  createdAt     DateTime       @default(now())
  @@index([importedById, createdAt])
}

/// Aportes por conta (bloco APORTES da planilha). Valor que entra na conta
/// para cobrir os pagamentos do periodo; nao e derivavel das linhas de pagamento.
model Contribution {
  id            String      @id @default(cuid())
  accountLabel  String
  amount        Decimal
  workId        String
  work          Work        @relation(fields: [workId], references: [id])
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([workId])
}

model Payment {
  id                String          @id @default(cuid())
  externalReference String?
  supplierName      String
  description       String
  amount            Decimal
  originalDueDate   DateTime
  currentDueDate    DateTime
  costCenter        String
  category          String          @default("")
  /// Campos que a planilha de origem omitiu, gravados com marcador. Array JSON
  /// de codigos (src/lib/missing-info.ts); "[]" significa que nada faltou. E o
  /// que permite o painel dizer *por que* um pagamento esta INDEFINIDO meses
  /// depois — a previa da importacao some assim que o lote e confirmado.
  missingInfo       String          @default("[]")
  uniqueKey         String          @unique
  status            PaymentStatus   @default(PENDENTE)
  workId            String
  work              Work            @relation(fields: [workId], references: [id])
  importBatchId     String
  importBatch       ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User            @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  actions           PaymentAction[]
  attachments       Attachment[]
  approvals         PaymentApproval[]
  tags              PaymentTag[]
  allocations       PaymentAllocation[]
  hasReceipt        Boolean         @default(false)
  receiptReceivedAt DateTime?
  appliedApprovalRuleId String?
  appliedApprovalRule ApprovalRule? @relation(fields: [appliedApprovalRuleId], references: [id], onDelete: SetNull)
  requiredApprovals  Int             @default(1)
  requiredApprovalRole Role          @default(GESTOR)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([workId])
  @@index([currentDueDate])
}

model ApprovalRule {
  id                  String    @id @default(cuid())
  name                String
  minAmount           Decimal   @default(0)
  maxAmount           Decimal?
  workId              String?
  work                Work?     @relation(fields: [workId], references: [id], onDelete: SetNull)
  category            String?
  tagId               String?
  tag                 Tag?      @relation(fields: [tagId], references: [id], onDelete: SetNull)
  requiredRole        Role      @default(GESTOR)
  requiredApprovals   Int       @default(1)
  preventSelfApproval Boolean   @default(true)
  priority            Int       @default(0)
  active              Boolean   @default(true)
  payments            Payment[]
  approvals           PaymentApproval[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([active, priority])
  @@index([workId])
  @@index([tagId])
}

model PaymentApproval {
  id             String       @id @default(cuid())
  paymentId      String
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  approvalRuleId String?
  approvalRule   ApprovalRule? @relation(fields: [approvalRuleId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@unique([paymentId, actorId])
  @@index([paymentId, createdAt])
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  color     String         @default("#3157A4")
  active    Boolean        @default(true)
  payments  PaymentTag[]
  rules     ApprovalRule[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PaymentTag {
  paymentId String
  tagId     String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([paymentId, tagId])
  @@index([tagId])
}

model StandardReason {
  id        String               @id @default(cuid())
  action    StandardReasonAction
  label     String
  active    Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([action, label])
  @@index([action, active, sortOrder])
}

model AllocationRule {
  id              String                @id @default(cuid())
  name            String
  category        String?
  supplierPattern String?
  active          Boolean               @default(true)
  priority        Int                   @default(0)
  splits          AllocationRuleSplit[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([active, priority])
}

model AllocationRuleSplit {
  id         String         @id @default(cuid())
  ruleId     String
  rule       AllocationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  workId     String
  work       Work           @relation(fields: [workId], references: [id])
  percentage Decimal

  @@unique([ruleId, workId])
  @@index([workId])
}

model PaymentAllocation {
  id         String           @id @default(cuid())
  paymentId  String
  payment    Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  workId     String
  work       Work             @relation(fields: [workId], references: [id])
  percentage Decimal
  amount     Decimal
  source     AllocationSource @default(MANUAL)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([paymentId, workId])
  @@index([workId])
}

model Advance {
  id               String        @id @default(cuid())
  collaboratorName String
  description      String
  amount           Decimal
  spentAmount      Decimal       @default(0)
  returnedAmount   Decimal       @default(0)
  grantedAt        DateTime
  dueDate          DateTime
  settledAt        DateTime?
  status           AdvanceStatus @default(ABERTO)
  notes            String?
  documents        String        @default("")
  workId           String?
  work             Work?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  createdById      String
  createdBy        User          @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, dueDate])
  @@index([workId])
}

model PaymentRequest {
  id             String               @id @default(cuid())
  supplierName   String
  description    String
  amount         Decimal
  dueDate        DateTime
  category       String               @default("")
  workId         String
  work           Work                 @relation(fields: [workId], references: [id])
  requestedById  String
  requestedBy    User                 @relation("PaymentRequestRequestedBy", fields: [requestedById], references: [id])
  status         PaymentRequestStatus @default(PENDENTE)
  reviewedById   String?
  reviewedBy     User?                @relation("PaymentRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewReason   String?
  attachments    PaymentRequestAttachment[]
  approvals      PaymentRequestApproval[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([workId, status, createdAt])
  @@index([requestedById, status, createdAt])
  @@index([status, createdAt])
}

model PaymentRequestAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([requestId])
}

/// Foto de nota fiscal enviada pelo colaborador de campo (cartao CAJU) pelo
/// PWA em /notas.
///
/// Sem cascade no autor de proposito: a nota e documento de auditoria e nao
/// pode sumir junto com a conta. A exclusao de usuario reatribui as notas ao
/// sentinel "usuario-removido", como ja acontece com o historico financeiro.
///
/// CRESCIMENTO: cada foto comprimida ocupa ~200-500 KB, o que da ordem de
/// 750 MB por mes em uso pleno (20 colaboradores x 5 notas por dia), e os
/// backups crescem junto. O `data` fica em TOAST, entao listagens que NAO
/// selecionam esse campo nao pagam por ele — e nenhuma consulta fora de
/// /api/notas/[id]/foto pode seleciona-lo. Se o volume apertar, a saida e
/// mover os bytes para object storage preservando a URL /api/notas/[id]/foto,
/// que e o unico endereco que o cliente conhece.
model ReceiptNote {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation("ReceiptNoteAuthor", fields: [userId], references: [id])
  /// UUID que o PWA gerou na captura, o mesmo valor que chega no cabecalho
  /// Idempotency-Key. E o que liga a foto da fila offline a esta linha: sem ele
  /// o cliente nao consegue casar o que enviou com o que a listagem devolve, e a
  /// mesma nota aparece duas vezes na tela do colaborador.
  ///
  /// NAO e a chave primaria de proposito: quem escolhe o id da linha e o
  /// servidor (cuid), nao o cliente. Nulo nas notas gravadas antes desta coluna
  /// existir — para o cliente, nulo significa "sem par local".
  ///
  /// UNIQUE e a segunda linha de defesa contra duplicata: a chave de
  /// idempotencia expira em 24h e a fila offline pode durar mais que isso, entao
  /// o banco ainda barra a segunda gravacao da mesma foto quando a primeira
  /// barreira ja caducou.
  clientKey   String?           @unique
  description String            @default("")
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  /// Relogio do celular no momento da captura: a foto pode ter sido tirada
  /// offline, horas antes de o envio chegar ao servidor.
  capturedAt  DateTime
  status      ReceiptNoteStatus @default(ENVIADA)
  /// Recebimento no servidor. Junto com capturedAt mostra o atraso do envio.
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PaymentAction {
  id             String         @id @default(cuid())
  paymentId      String
  payment        Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User           @relation(fields: [actorId], references: [id])
  type           ActionType
  previousStatus PaymentStatus?
  newStatus      PaymentStatus
  reason         String?
  newDueDate     DateTime?
  note           String?
  createdAt      DateTime       @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName   String
  url        String
  uploadedBy String
  createdAt  DateTime @default(now())
}

model DailyFlow {
  id              String          @id @default(cuid())
  importBatchId   String          @unique
  importBatch     ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  status          DailyFlowStatus @default(RASCUNHO)
  startedById     String?
  startedBy       User?           @relation("DailyFlowStartedBy", fields: [startedById], references: [id])
  startedAt       DateTime?
  closedById      String?
  closedBy        User?           @relation("DailyFlowClosedBy", fields: [closedById], references: [id])
  closedAt        DateTime?
  finalSummary    String          @default("{}")
  events          DailyFlowEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
}

model DailyFlowEvent {
  id          String             @id @default(cuid())
  dailyFlowId String
  dailyFlow   DailyFlow          @relation(fields: [dailyFlowId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User               @relation("DailyFlowEventActor", fields: [actorId], references: [id])
  type        DailyFlowEventType
  reason      String?
  metadata    String             @default("{}")
  createdAt   DateTime           @default(now())

  @@index([dailyFlowId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  event     String
  entity    String
  entityId  String?
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  scope        String
  key          String
  actorId      String?
  status       Int
  response     String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

/// Aviso de manutencao do sistema. Linha unica (id fixo "singleton"): quem liga
/// e quando ficam gravados para o painel exibir o coordenador que sinalizou a
/// manutencao. So coordenadores leem/alteram este registro.
model MaintenanceNotice {
  id              String    @id @default("singleton")
  active          Boolean   @default(false)
  activatedById   String?
  activatedByName String?
  activatedAt     DateTime?
  reason          String?
  estimatedEndAt  DateTime?
  updatedAt       DateTime  @updatedAt
}
