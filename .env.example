# Copie para .env e ajuste os valores.

# Banco PostgreSQL local. No Render, use a Internal Database URL do banco
# gerenciado, mantendo o Web Service e o PostgreSQL na mesma regiao.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fluxo?schema=public"

# Segredo de assinatura da sessao (JWT). Use um valor longo e aleatorio.
AUTH_SECRET="troque-por-um-valor-longo-e-aleatorio"

# Senhas opcionais usadas somente ao criar as contas administrativas do seed.
# Se ficarem vazias, o seed gera senhas aleatorias e as imprime uma unica vez.
SEED_ADMIN_PASSWORD=""
SEED_ARTHUR_PASSWORD=""

# Login corporativo OIDC (Microsoft Entra ID, Google Workspace ou outro provedor).
# Deixe OIDC_ISSUER vazio para manter apenas o login local.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_PROVIDER_NAME="Microsoft 365"
OIDC_ALLOWED_DOMAINS="empresa.com.br"
# OIDC_REDIRECT_URI="https://seu-dominio/api/auth/oidc/callback"
